# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật. File .env KHÔNG được commit.
# Key Gemini miễn phí: https://aistudio.google.com/apikey
GEMINI_API_KEY=dan-key-gemini-vao-day
# (Tuỳ chọn) AI dự phòng khi Gemini bận: key Groq miễn phí https://console.groq.com/keys . Để trống = tắt.
BACKUP_AI_KEY=
# Mật khẩu chung giữa robot và server (tự đặt, phải giống ROBOT_TOKEN trong secrets.h của robot).
ROBOT_TOKEN=xetang-bi-mat
# Cổng server lắng nghe.
PORT=8765
# Giọng nói Gemini: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr...
VOICE=Puck
# 1 = cho Gemini gọi hàm "cu_dong" để điều khiển xe (robot mới in ra, chưa chạy động cơ). 0 = tắt.
TOOLS=1
# Số lượt hội thoại gần nhất được nhớ lại (lưu trong memory.json). 0 = không nhớ.
MEMORY_TURNS=20
